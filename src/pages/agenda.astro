---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroWofyDesktop from '../assets/hero-image-desktop.png';
import heroWofyMobile from '../assets/hero-image-mobile.png';
import agendaFeature from '../assets/agenda-feature.png';
import serviceVet from '../assets/agenda-feature.png';
import dashboardImage from '../assets/dashboard.png';

const title =
	'Agenda veterinaria para clinicas modernas | Citas, recordatorios y seguimiento | Wofy';
const description =
	'Wofy ayuda a organizar tu agenda veterinaria con gestion de citas, seguimientos, recordatorios por WhatsApp y una vista mas clara del dia a dia de la clinica.';

const quickWins = [
	{
		title: 'Citas mas ordenadas',
		description:
			'Consulta el dia con mas claridad y evita cruces o olvidos en la operacion.',
	},
	{
		title: 'Seguimiento del dia',
		description:
			'Revisa atendidas, pendientes y por atender desde una misma agenda veterinaria.',
	},
	{
		title: 'Recordatorios por WhatsApp',
		description:
			'Confirma citas y acompana a los tutores con mensajes en momentos clave.',
	},
	{
		title: 'Equipo mejor coordinado',
		description:
			'Todos trabajan sobre la misma vista para mover la agenda con menos friccion.',
	},
];

const operatingPoints = [
	'Organiza la carga del dia sin depender de chats o notas sueltas.',
	'Identifica pendientes y seguimientos antes de que afecten la atencion.',
	'Da mas visibilidad a la recepcion y al equipo clinico sobre lo que viene.',
	'Conecta la agenda con el resto de la operacion de la clinica.',
];
---

<Layout title={title} description={description}>
	<main>
		<section class="px-8 sm:px-20 mt-4 md:mt-10">
			<div class="mx-auto max-w-6xl px-6 pb-14 pt-2 md:pb-20">
				<div class="text-center">
					<a
						href="#modulos"
						class="relative inline-flex rounded-full p-px
							bg-[linear-gradient(90deg,#44cac0,#7ef0e6,#44cac0)]
							bg-size[200%_200%]
							animate-[borderMove_4s_linear_infinite]
							shadow-[0_0_20px_rgba(68,202,192,0.25)]
							transition-all duration-300
							hover:scale-[1.04]
							hover:shadow-[0_0_30px_rgba(68,202,192,0.4)]
							focus:outline-none focus:ring-2 focus:ring-[#44cac0]/40"
					>
						<span
							class="flex items-center gap-2 rounded-full bg-white px-4 py-1 text-xs shadow-sm"
						>
							<span
								class="rounded-full bg-[#ff1fa9]/10 px-2 py-0.5 font-semibold tracking-wide text-[#ff1fa9]"
							>
								AGENDA
							</span>
							<span class="font-medium text-wofy-black">
								Controla tus citas desde un solo lugar
							</span>
						</span>
					</a>

					<h1
						class="mx-auto mt-5 max-w-4xl text-balance text-4xl font-semibold tracking-tight text-black md:text-6xl"
					>
						La <span class="text-puerto-rico-600">agenda veterinaria</span>
						para clinicas que quieren atender con mas orden y menos cruces.
					</h1>

					<p
						class="mx-auto mt-5 max-w-3xl text-pretty text-md leading-relaxed text-wofy-black md:text-lg"
					>
						Wofy ayuda a gestionar citas, seguimientos y recordatorios desde una
						vista mas clara para recepcion y equipo clinico. Si hoy tu agenda se
						divide entre WhatsApp, notas y memoria, esta pagina esta hecha para
						ese problema.
					</p>

					<div class="mt-8 flex items-center justify-center gap-3">
						<a
							href="https://wa.link/y8hfqg"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-2xl bg-puerto-rico-500 px-5 py-3 text-sm font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700 sm:px-10 sm:text-lg"
						>
							Quiero ver la agenda
						</a>
						<a
							href="#modulos"
							class="inline-block rounded-2xl border border-puerto-rico-500 bg-wofy-white px-3 py-3 text-sm font-bold text-puerto-rico-500 transition duration-300 ease-in-out hover:bg-puerto-rico-500 hover:text-wofy-white sm:px-8 sm:text-lg"
						>
							Ver como funciona
						</a>
					</div>

					<p class="mt-5 text-xs text-slate-900/70 md:text-sm">
						Agenda clara • Recordatorios utiles • Menos carga manual para el
						equipo
					</p>
				</div>

				<div class="relative mx-auto mt-12 max-w-7xl">
					<div class="md:hidden">
						<Image
							src={heroWofyMobile}
							alt="Vista movil de Wofy con agenda veterinaria y recordatorios"
							class="h-auto w-full"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					<div class="hidden md:block">
						<Image
							src={heroWofyDesktop}
							alt="Vista de Wofy con agenda veterinaria, historial clinico y panel de negocio"
							class="h-auto w-full"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				</div>

				<div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
					{
						quickWins.map((item) => (
							<article class="rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm">
								<h2 class="text-xl font-semibold text-black">{item.title}</h2>
								<p class="mt-3 text-sm leading-7 text-wofy-black md:text-base">
									{item.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section id="modulos" class="bg-puerto-rico-50/80">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<div class="text-center">
					<div class="relative inline-flex rounded-full p-px">
						<span
							class="flex items-center gap-2 rounded-full bg-puerto-rico-600 px-5 py-2 text-xs"
						>
							<span class="text-sm font-medium text-wofy-white">
								Lo que necesitas para el dia a dia
							</span>
						</span>
					</div>
					<h2 class="mx-auto mt-8 max-w-4xl">
						<span class="text-3xl font-semibold md:text-5xl">
							Una agenda de citas veterinarias que si ayuda a operar mejor
						</span>
					</h2>
					<p class="mx-auto mt-8 max-w-2xl text-lg text-wofy-black">
						No es solo poner horas en un calendario. La agenda veterinaria tiene
						que mostrar el estado de cada cita, ayudar con seguimientos y
						darle visibilidad al equipo para atender con menos ruido.
					</p>
				</div>

				<div>
					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-5 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-xl">
								<h2
									class="mb-6 text-3xl font-medium md:text-5xl md:font-semibold"
								>
									Ve el dia con citas, horarios y seguimientos en una sola vista
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Organiza la jornada sin tener que reconstruir todo desde chats,
									llamadas o recordatorios manuales. La agenda te deja ver lo que
									esta confirmado, lo que sigue y lo que necesita atencion.
								</p>
							</div>
							<div>
								<Image
									class="w-xs md:w-xl max-w-2xl"
									src={agendaFeature}
									alt="Agenda veterinaria de Wofy con calendario, citas y estados de atencion"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-5 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row-reverse md:px-16"
						>
							<div class="max-w-xl">
								<h2
									class="mb-6 text-3xl font-medium md:text-5xl md:font-semibold"
								>
									Gestiona citas con recordatorios y acciones desde el mismo flujo
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Cuando la agenda y los recordatorios viven juntos, el equipo
									pierde menos tiempo persiguiendo pendientes. Eso ayuda a reducir
									ausencias y a mover la operacion con mas tranquilidad.
								</p>
							</div>
							<div>
								<Image
									class="w-xs md:w-xl max-w-2xl"
									src={serviceVet}
									alt="Modulo de gestion de citas veterinarias con acciones y recordatorios en Wofy"
								/>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="px-8 sm:px-20 mt-20 lg:mt-32">
			<div class="mx-auto flex max-w-6xl flex-col items-center gap-10 lg:flex-row lg:gap-14">
				<div class="max-w-2xl">
					<h2 class="text-3xl font-semibold text-black md:text-5xl">
						Una buena agenda veterinaria tambien mejora el ritmo de toda la
						clinica
					</h2>
					<p class="mt-6 text-lg leading-8 text-wofy-black">
						Cuando el equipo sabe que viene, que ya paso y que sigue, trabaja con
						mas control. Wofy conecta la agenda con el movimiento general de la
						clinica para que recepcion y operacion no trabajen a ciegas.
					</p>
					<ul class="mt-8 space-y-4">
						{
							operatingPoints.map((point) => (
								<li class="flex gap-3 text-base leading-7 text-wofy-black md:text-lg">
									<span class="mt-2 h-2.5 w-2.5 rounded-full bg-puerto-rico-500"></span>
									<span>{point}</span>
								</li>
							))
						}
					</ul>
					<a
						href="https://wa.link/y8hfqg"
						target="_blank"
						rel="noopener noreferrer"
						class="mt-8 inline-block rounded-2xl bg-puerto-rico-500 px-6 py-4 text-base font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700"
					>
						Hablar con Wofy
					</a>
				</div>

				<div class="w-full max-w-3xl rounded-4xl border border-slate-200/70 bg-white p-4 shadow-xl md:p-6">
					<Image
						src={dashboardImage}
						alt="Panel de Wofy con citas, ingresos y movimiento general de la clinica"
						class="h-auto w-full"
					/>
				</div>
			</div>
		</section>
	</main>
</Layout>
