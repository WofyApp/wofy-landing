---
import Layout from '../layouts/Layout.astro';
import FeatureCTA from '../components/FeatureCTA.astro';
import { Image } from 'astro:assets';
import agendaHero from '../assets/agenda-page-hero.png';
import agendaFeatures1 from '../assets/agenda-features-1.png';
import agendaFeatures2 from '../assets/agenda-features-2.png';

const title = 'Agenda veterinaria online con WhatsApp | Wofy';
const description =
	'Gestiona citas, envía recordatorios y automatiza tu veterinaria con Wofy. Agenda inteligente conectada a WhatsApp.';

const quickWins = [
	{
		title: 'Citas más ordenadas. Control total',
		description:
			'Visualiza todas las citas de la clínica en un solo lugar y de forma clara. Olvídate de perder información valiosa.'
	},
	{
		title: 'Seguimiento del día a tu ritmo',
		description:
			'Revisa las citas atendidas, pendientes y por atender desde una misma agenda veterinaria. Nunca más sorpresas a última hora.'
	},
	{
		title: 'Recordatorios por WhatsApp',
		description:
			'Confirma las citas, reduce ausencias y mantente en contacto con tus clientes sin esfuerzo.'
	},
	{
		title: 'Menos tiempo respondiendo chats',
		description:
			'Con un Chatbot 24/7 que agenda por ti, te enfocas en lo importante: atender a tus pacientes.'
	}
];

---

<Layout title={title} description={description}>
	<main>
		<section class="px-8 sm:px-20 mt-4 md:mt-10">
			<div class="mx-auto max-w-6xl px-6 pb-14 pt-2 md:pb-20">
				<div class="text-center">
					<a
						href="#modulos"
						class="relative inline-flex rounded-full p-px
							bg-[linear-gradient(90deg,#44cac0,#7ef0e6,#44cac0)]
							bg-size[200%_200%]
							animate-[borderMove_4s_linear_infinite]
							shadow-[0_0_20px_rgba(68,202,192,0.25)]
							transition-all duration-300
							hover:scale-[1.04]
							hover:shadow-[0_0_30px_rgba(68,202,192,0.4)]
							focus:outline-none focus:ring-2 focus:ring-[#44cac0]/40"
					>
						<span
							class="flex items-center gap-2 rounded-full bg-white px-4 py-1 text-xs shadow-sm"
						>
							<span
								class="rounded-full bg-[#ff1fa9]/10 px-2 py-0.5 font-semibold tracking-wide text-[#ff1fa9]"
							>
								AGENDA
							</span>
							<span class="font-medium text-wofy-black">
								Controla tus citas desde un solo lugar
							</span>
						</span>
					</a>

					<h1
						class="mx-auto mt-5 max-w-4xl text-balance text-4xl font-semibold tracking-tight text-black md:text-6xl"
					>
						Tu <span class="text-puerto-rico-600"
							>agenda veterinaria</span
						>
						automatizada por WhatsApp
					</h1>

					<p
						class="mx-auto mt-5 max-w-3xl text-pretty text-md leading-relaxed text-wofy-black md:text-lg"
					>
						Olvídate del desorden, las citas perdidas y los mensajes
						manuales. Wofy agenda, recuerda y organiza todo por ti.
					</p>

					<div class="mt-8 flex items-center justify-center gap-3">
						<a
							href="https://wa.link/y8hfqg"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-2xl bg-puerto-rico-500 px-5 py-3 text-sm font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700 sm:px-10 sm:text-lg"
						>
							Quiero ver la agenda
						</a>
						<a
							href="#modulos"
							class="inline-block rounded-2xl border border-puerto-rico-500 bg-wofy-white px-3 py-3 text-sm font-bold text-puerto-rico-500 transition duration-300 ease-in-out hover:bg-puerto-rico-500 hover:text-wofy-white sm:px-8 sm:text-lg"
						>
							Ver cómo funciona
						</a>
					</div>

					<p class="mt-5 text-xs text-slate-900/70 md:text-sm">
						Agenda clara • Recordatorios útiles • Menos carga manual
						para el equipo
					</p>
				</div>

				<div class="relative mx-auto mt-12 max-w-7xl">
					<div class="md:hidden">
						<Image
							src={agendaHero}
							alt="Vista móvil de Wofy con agenda veterinaria y recordatorios"
							class="h-auto w-full"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					<div class="hidden md:block">
						<Image
							src={agendaHero}
							alt="Vista de Wofy con agenda veterinaria, historial clínico y panel de negocio"
							class="h-auto w-full"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				</div>

				<div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
					{
						quickWins.map((item) => (
							<article class="rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm">
								<h2 class="text-xl font-semibold text-black">
									{item.title}
								</h2>
								<p class="mt-3 text-sm leading-7 text-wofy-black md:text-base">
									{item.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section id="modulos" class="bg-puerto-rico-50/80">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<div class="text-center">
					<div class="relative inline-flex rounded-full p-px">
						<span
							class="flex items-center gap-2 rounded-full bg-puerto-rico-600 px-5 py-2 text-xs"
						>
							<span class="text-sm font-medium text-wofy-white">
								Lo que necesitas para el día a día
							</span>
						</span>
					</div>
					<h2 class="mx-auto mt-8 max-w-4xl">
						<span class="text-3xl font-semibold md:text-5xl">
							Una agenda de citas veterinarias que sí ayuda a
							operar mejor
						</span>
					</h2>
					<p class="mx-auto mt-8 max-w-2xl text-lg text-wofy-black">
						No es solo poner horas en un calendario. La agenda
						veterinaria tiene que mostrar el estado de cada cita,
						ayudar con seguimientos y darle visibilidad al equipo
						para atender con menos ruido.
					</p>
				</div>

				<div>
					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-16 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-sm">
								<h2
									class="mb-6 text-2xl font-semibold md:text-4xl"
								>
									Ve el día con citas, horarios y calendario
									en un mismo lugar
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Organiza la jornada sin tener que
									reconstruir todo desde chats, llamadas o
									recordatorios manuales. La agenda te deja
									ver lo que está confirmado, lo que sigue y
									lo que necesita atención.
								</p>
							</div>
							<div>
								<Image
									class="md:w-lg w-sm"
									src={agendaFeatures1}
									alt="Agenda veterinaria de Wofy con calendario, citas y estados de atención"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-16 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row-reverse md:px-16"
						>
							<div class="max-w-sm">
								<h2
									class="mb-6 text-2xl font-semibold md:text-4xl"
								>
									Mantén el control con información dinámica
									sobre cada cita
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									No es solo saber que hay una cita a las 3 p. m.
									La agenda te muestra el estado de cada cita,
									te ayuda a hacer seguimientos y le da
									visibilidad al equipo para que todos sepan
									que viene, que pasó y que sigue.
								</p>
							</div>
							<div>
								<Image
									class="max-w-md"
									src={agendaFeatures2}
									alt="Módulo de gestión de citas veterinarias con acciones y recordatorios en Wofy"
								/>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>
		<FeatureCTA header="Menos llamadas. Más citas. Más mascotas felices." />
	</main>
</Layout>
