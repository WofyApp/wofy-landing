---
import Layout from '../layouts/Layout.astro';
import FeatureCTA from '../components/FeatureCTA.astro';
import { Image } from 'astro:assets';
import historialHero from '../assets/historial-page-hero.png';
import historialFeature1 from '../assets/historial-features-1.png';
import historialFeature2 from '../assets/historial-features-2.png';

const title =
	'Historia clínica veterinaria para clínicas modernas | Evolución, vacunas y consentimientos | Wofy';
const description =
	'Wofy ayuda a llevar la historia clínica veterinaria de cada mascota con consultas, evolución, vacunas, archivos y consentimientos informados digitales en un solo flujo.';

const quickWins = [
	{
		title: 'Historial por mascota',
		description:
			'Consulta antecedentes, notas y estado clínico sin perder tiempo buscando en varias partes.'
	},
	{
		title: 'Vacunas y archivos',
		description:
			'Mantén vacunas, documentos y registros clínicos dentro de una misma vista.'
	},
	{
		title: 'Consentimientos digitales',
		description:
			'Integra consentimientos informados digitales dentro del seguimiento clínico diario.'
	},
	{
		title: 'Menos fricción al atender',
		description:
			'El equipo encuentra la información más rápido y atiende con más contexto.'
	}
];

const operatingPoints = [
	'Reduce el tiempo perdido buscando antecedentes, archivos o notas clínicas.',
	'Da más continuidad a la atención cuando distintos miembros del equipo revisan el caso.',
	'Conecta historia clínica, consentimientos y recordatorios dentro del mismo proceso.',
	'Mejora la trazabilidad de cada paciente cuando la clínica empieza a crecer.'
];
---

<Layout title={title} description={description}>
	<main>
		<section class="px-8 sm:px-20 mt-4 md:mt-10">
			<div class="mx-auto max-w-6xl px-6 pb-14 pt-2 md:pb-20">
				<div class="text-center">
					<a
						href="#modulos"
						class="relative inline-flex rounded-full p-px
							bg-[linear-gradient(90deg,#44cac0,#7ef0e6,#44cac0)]
							bg-size[200%_200%]
							animate-[borderMove_4s_linear_infinite]
							shadow-[0_0_20px_rgba(68,202,192,0.25)]
							transition-all duration-300
							hover:scale-[1.04]
							hover:shadow-[0_0_30px_rgba(68,202,192,0.4)]
							focus:outline-none focus:ring-2 focus:ring-[#44cac0]/40"
					>
						<span
							class="flex items-center gap-2 rounded-full bg-white px-4 py-1 text-xs shadow-sm"
						>
							<span
								class="rounded-full bg-[#ff1fa9]/10 px-2 py-0.5 font-semibold tracking-wide text-[#ff1fa9]"
							>
								CLINICA
							</span>
							<span class="font-medium text-wofy-black">
								Consulta el historial desde una sola vista
							</span>
						</span>
					</a>

					<h1
						class="mx-auto mt-5 max-w-4xl text-balance text-4xl font-semibold tracking-tight text-black md:text-6xl"
					>
						Un <span class="text-puerto-rico-600"
							>historial clínico</span
						>
						a la altura de tu veterinaria
					</h1>

					<p
						class="mx-auto mt-5 max-w-3xl text-pretty text-md leading-relaxed text-wofy-black md:text-lg"
					>
						Olvídate del papel, los errores y la información
						perdida. Accede a todo en segundos, desde cualquier
						lugar.
					</p>

					<div class="mt-8 flex items-center justify-center gap-3">
						<a
							href="https://wa.link/y8hfqg"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-2xl bg-puerto-rico-500 px-5 py-3 text-sm font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700 sm:px-10 sm:text-lg"
						>
							Quiero ver el historial
						</a>
						<a
							href="#modulos"
							class="inline-block rounded-2xl border border-puerto-rico-500 bg-wofy-white px-3 py-3 text-sm font-bold text-puerto-rico-500 transition duration-300 ease-in-out hover:bg-puerto-rico-500 hover:text-wofy-white sm:px-8 sm:text-lg"
						>
							Ver cómo funciona
						</a>
					</div>

					<p class="mt-5 text-xs text-slate-900/70 md:text-sm">
						Más contexto clínico • Mejor seguimiento • Menos
						búsqueda manual
					</p>
				</div>

				<div class="relative mx-auto mt-12 max-w-5xl rounded-4xl">
					<Image
						src={historialHero}
						alt="Pantalla de historia clínica veterinaria en Wofy con consultas, notas, vacunas y consentimientos"
						class="h-auto w-full"
						loading="eager"
						fetchpriority="high"
					/>
				</div>

				<div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
					{
						quickWins.map((item) => (
							<article class="rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm">
								<h2 class="text-xl font-semibold text-black">
									{item.title}
								</h2>
								<p class="mt-3 text-sm leading-7 text-wofy-black md:text-base">
									{item.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section id="modulos" class="bg-puerto-rico-50/80">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<div class="text-center">
					<div class="relative inline-flex rounded-full p-px">
						<span
							class="flex items-center gap-2 rounded-full bg-puerto-rico-600 px-5 py-2 text-xs"
						>
							<span class="text-sm font-medium text-wofy-white">
								Lo que necesitas para atender mejor
							</span>
						</span>
					</div>
					<h2 class="mx-auto mt-8 max-w-4xl">
						<span class="text-3xl font-semibold md:text-5xl">
							Una historia clínica veterinaria que no se queda
							corta en el día a día
						</span>
					</h2>
					<p class="mx-auto mt-8 max-w-2xl text-lg text-wofy-black">
						No basta con guardar registros. La historia clínica
						tiene que dejarte entender rápido qué pasó con cada
						paciente, qué sigue y qué documentos hacen parte del
						caso.
					</p>
				</div>

				<div>
					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-16 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-sm">
								<h2
									class="mb-6 text-2xl font-semibold md:text-4xl"
								>
									Revisa consultas, vacunas y evolución en una
									sola cronología
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Accede rápido a la información clínica de
									cada mascota para atender con más contexto.
									Menos tiempo buscando antecedentes y más
									seguridad al momento de tomar decisiones
									durante la consulta.
								</p>
							</div>
							<div>
								<Image
									class="md:w-lg w-sm"
									src={historialFeature1}
									alt="Cronología de historia clínica veterinaria con consultas, vacunas y notas en Wofy"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-16 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row-reverse md:px-16"
						>
							<div class="max-w-sm">
								<h2
									class="mb-6 text-2xl font-semibold md:text-4xl"
								>
									Integra consentimientos informados digitales
									dentro del flujo clínico
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Cuando los consentimientos viven junto al
									historial, el proceso clínico se siente más
									completo y menos fragmentado. Eso te ayuda a
									mantener mejor trazabilidad sin salir del
									contexto del paciente.
								</p>
							</div>
							<div>
								<Image
									class="max-w-md"
									src={historialFeature2}
									alt="Vista de Wofy con historia clínica, documentos y módulos de seguimiento veterinario"
								/>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>
		<FeatureCTA
			header="Es hora de tener un historial clínico que realmente te dé valor"
		/>
	</main>
</Layout>
