---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroWofyDesktop from '../assets/hero-image-desktop.png';
import heroWofyMobile from '../assets/hero-image-mobile.png';
import serviceVet from '../assets/agenda-feature.png';
import historialFeature from '../assets/historial-feature.png';
import marketingFeature from '../assets/marketing-feature.png';
import dashboardImage from '../assets/dashboard.png';

const title =
	'Software veterinario para clinicas modernas | Agenda, historia clinica, consentimientos y recordatorios | Wofy';
const description =
	'Wofy es un software veterinario en la nube para clinicas que quieren ordenar agenda veterinaria, historia clinica, consentimientos informados digitales, control de pacientes, recordatorios por WhatsApp e informes del negocio desde un solo lugar.';

const quickWins = [
	{
		title: 'Gestion de citas',
		description:
			'Ordena agenda veterinaria, pendientes y recordatorios desde una sola vista.',
	},
	{
		title: 'Control de pacientes',
		description:
			'Sigue la historia clinica, vacunas, consultas y tratamientos con trazabilidad por mascota.',
	},
	{
		title: 'Notificaciones y seguimiento',
		description:
			'Envía recordatorios y mensajes a tutores en momentos clave, sin perder orden interno.',
	},
	{
		title: 'Consentimientos digitales',
		description:
			'Organiza consentimientos informados digitales dentro del flujo clinico, sin depender de formatos sueltos.',
	},
];

const operatingPoints = [
	'Consulta informes en tiempo real sin armar reportes manuales cada semana.',
	'Manten tu informacion en la nube para trabajar desde donde lo necesites.',
	'Da mas orden a los procesos internos cuando la clinica empieza a crecer.',
	'Centraliza documentos clinicos como consentimientos informados sin salir del proceso.',
];
---

<Layout title={title} description={description}>
	<main>
		<section class="px-8 sm:px-20 mt-4 md:mt-10">
			<div class="mx-auto max-w-6xl px-6 pb-14 pt-2 md:pb-20">
				<div class="text-center">
					<a
						href="#modulos"
						class="relative inline-flex rounded-full p-px
							bg-[linear-gradient(90deg,#44cac0,#7ef0e6,#44cac0)]
							bg-size[200%_200%]
							animate-[borderMove_4s_linear_infinite]
							shadow-[0_0_20px_rgba(68,202,192,0.25)]
							transition-all duration-300
							hover:scale-[1.04]
							hover:shadow-[0_0_30px_rgba(68,202,192,0.4)]
							focus:outline-none focus:ring-2 focus:ring-[#44cac0]/40"
					>
						<span
							class="flex items-center gap-2 rounded-full bg-white px-4 py-1 text-xs shadow-sm"
						>
							<span
								class="rounded-full bg-[#ff1fa9]/10 px-2 py-0.5 font-semibold tracking-wide text-[#ff1fa9]"
							>
								WOFY
							</span>
							<span class="font-medium text-wofy-black">
								Gestion veterinaria en un solo lugar
							</span>
						</span>
					</a>

					<h1
						class="mx-auto mt-5 max-w-4xl text-balance text-4xl font-semibold tracking-tight text-black md:text-6xl"
					>
						El <span class="text-puerto-rico-600">software veterinario</span>
						para clinicas que quieren gestionar mejor su operacion, sus
						pacientes y sus citas.
					</h1>

					<p
						class="mx-auto mt-5 max-w-3xl text-pretty text-md leading-relaxed text-wofy-black md:text-lg"
					>
						Wofy reune agenda veterinaria, historia clinica, control de
						pacientes y tutores, consentimientos informados digitales,
						recordatorios por WhatsApp e informes del negocio en una sola
						plataforma en la nube, todo desde un solo lugar. Esta pensada para
						clinicas modernas que quieren organizar procesos internos sin perder
						agilidad en la atencion.
					</p>

					<div class="mt-8 flex items-center justify-center gap-3">
						<a
							href="https://wa.link/y8hfqg"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-2xl bg-puerto-rico-500 px-5 py-3 text-sm font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700 sm:px-10 sm:text-lg"
						>
							Empieza gratis ahora
						</a>
						<a
							href="#modulos"
							class="inline-block rounded-2xl border border-puerto-rico-500 bg-wofy-white px-3 py-3 text-sm font-bold text-puerto-rico-500 transition duration-300 ease-in-out hover:bg-puerto-rico-500 hover:text-wofy-white sm:px-8 sm:text-lg"
						>
							Ver modulos
						</a>
					</div>

					<p class="mt-5 text-xs text-slate-900/70 md:text-sm">
						En la nube • Soporte cercano • Pensado para procesos reales de una
						clinica veterinaria
					</p>
				</div>

				<div class="relative mx-auto mt-12 max-w-7xl">
					<div class="md:hidden">
						<Image
							src={heroWofyMobile}
							alt="Vista movil de Wofy con agenda, recordatorios y panel para clinicas veterinarias"
							class="h-auto w-full"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					<div class="hidden md:block">
						<Image
							src={heroWofyDesktop}
							alt="Vista de Wofy con panel de negocio, historial clinico y agenda veterinaria"
							class="h-auto w-full"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				</div>

				<div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
					{
						quickWins.map((item) => (
							<article class="rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm">
								<h2 class="text-xl font-semibold text-black">{item.title}</h2>
								<p class="mt-3 text-sm leading-7 text-wofy-black md:text-base">
									{item.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section id="modulos" class="bg-puerto-rico-50/80">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<div class="text-center">
					<div class="relative inline-flex rounded-full p-px">
						<span
							class="flex items-center gap-2 rounded-full bg-puerto-rico-600 px-5 py-2 text-xs"
						>
							<span class="text-sm font-medium text-wofy-white">
								Lo que mas usan las clinicas
							</span>
						</span>
					</div>
					<h2 class="mx-auto mt-8 max-w-4xl">
						<span class="text-3xl font-semibold md:text-5xl">
							Una plataforma que responde a lo que pasa en el dia a dia
						</span>
					</h2>
					<p class="mx-auto mt-8 max-w-2xl text-lg text-wofy-black">
						No se trata solo de tener agenda. Se trata de conectar gestion de
						citas, historia clinica, control de pacientes, consentimientos
						informados digitales y comunicacion con tutores para que la
						operacion se sienta mas clara.
					</p>
				</div>

				<div>
					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-5 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-xl">
								<h2
									class="mb-6 text-3xl font-medium md:text-5xl md:font-semibold"
								>
									Agenda veterinaria con citas, seguimientos y recordatorios
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Gestiona citas, revisa seguimientos y manten el control del
									dia desde un solo lugar. Cuando la agenda esta conectada con la
									operacion, el equipo responde mejor y se reducen los olvidos.
								</p>
							</div>
							<div>
								<Image
									class="w-xs md:w-xl max-w-2xl"
									src={serviceVet}
									alt="Modulo de gestion de citas de Wofy para clinicas veterinarias"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-5 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row-reverse md:px-16"
						>
							<div class="max-w-xl">
								<h2
									class="mb-6 text-3xl font-medium md:text-5xl md:font-semibold"
								>
									Historia clinica veterinaria con trazabilidad por paciente
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Accede a consultas, vacunas, archivos, notas y evolucion desde
									una cronologia clara por mascota. Tambien puedes mantener
									consentimientos informados digitales dentro del mismo flujo,
									con menos tiempo buscando informacion y mas seguridad al
									momento de atender.
								</p>
							</div>
							<div>
								<Image
									class="w-xs md:w-xl max-w-2xl"
									src={historialFeature}
									alt="Pantalla de historial clinico veterinario por mascota en Wofy"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-5 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-xl">
								<h2
									class="mb-6 text-3xl font-medium md:text-5xl md:font-semibold"
								>
									Notificaciones y recordatorios para tus tutores por WhatsApp
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Activa recordatorios, mensajes personalizados y seguimientos en
									los momentos clave. Asi fidelizas tutores y mantienes una
									comunicacion mas consistente sin improvisar cada contacto.
								</p>
							</div>
							<div>
								<Image
									class="w-sm md:w-xl max-w-2xl"
									src={marketingFeature}
									alt="Modulo de marketing inteligente por WhatsApp para veterinarias en Wofy"
								/>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="px-8 sm:px-20 mt-20 lg:mt-32">
			<div class="mx-auto flex max-w-6xl flex-col items-center gap-10 lg:flex-row lg:gap-14">
				<div class="max-w-2xl">
					<h2 class="text-3xl font-semibold text-black md:text-5xl">
						Si la clinica ya esta creciendo, necesitas gestion veterinaria con
						informes en tiempo real
					</h2>
					<p class="mt-6 text-lg leading-8 text-wofy-black">
						Un software para veterinarias tambien tiene que ayudarte a entender
						el negocio. Por eso Wofy muestra el movimiento de la clinica en un
						panel simple, para que no tengas que reconstruir a mano los datos
						cada vez que quieras revisar citas, ingresos o servicios, incluso
						cuando estas fuera de la clinica.
					</p>
					<ul class="mt-8 space-y-4">
						{
							operatingPoints.map((point) => (
								<li class="flex gap-3 text-base leading-7 text-wofy-black md:text-lg">
									<span class="mt-2 h-2.5 w-2.5 rounded-full bg-puerto-rico-500"></span>
									<span>{point}</span>
								</li>
							))
						}
					</ul>
					<a
						href="https://wa.link/y8hfqg"
						target="_blank"
						rel="noopener noreferrer"
						class="mt-8 inline-block rounded-2xl bg-puerto-rico-500 px-6 py-4 text-base font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700"
					>
						Quiero ver Wofy funcionando
					</a>
				</div>

				<div class="w-full max-w-3xl rounded-[2rem] border border-slate-200/70 bg-white p-4 shadow-xl md:p-6">
					<Image
						src={dashboardImage}
						alt="Panel de control de Wofy con citas, ingresos y servicios mas agendados"
						class="h-auto w-full"
					/>
				</div>
			</div>
		</section>
	</main>
</Layout>
