---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import marketingFeature from '../assets/marketing-feature.png';
import birthdayImage from '../assets/cumpleaños.png';
import chatImage from '../assets/chat.png';

const title =
	'Marketing veterinario por WhatsApp | Segmentacion, retencion y campanas dirigidas | Wofy';
const description =
	'Wofy ayuda a hacer marketing veterinario dirigido por WhatsApp con segmentacion de audiencias, mensajes personalizados, campanas de retencion, cumpleanos y reactivacion de clientes.';

const quickWins = [
	{
		title: 'Segmentacion real',
		description:
			'Dirige mensajes por tipo de mascota, edad, raza u otras condiciones utiles para la clinica.',
	},
	{
		title: 'Campanas por WhatsApp',
		description:
			'Lanza mensajes dirigidos sin tratar a todos los tutores como si fueran el mismo caso.',
	},
	{
		title: 'Retencion y reactivacion',
		description:
			'Recupera clientes inactivos y mantente presente con comunicaciones mas oportunas.',
	},
	{
		title: 'Cumpleanos y fechas clave',
		description:
			'Activa acciones especiales en momentos que si ayudan a fortalecer la relacion con el tutor.',
	},
];

const operatingPoints = [
	'El marketing deja de ser masivo y empieza a responder a perfiles reales de tus pacientes.',
	'WhatsApp sirve para vender mejor cuando la segmentacion y el mensaje tienen contexto.',
	'Ayuda a retener clientes con campanas mas relevantes para cada audiencia.',
	'El equipo puede mover acciones comerciales sin salir del flujo diario de la clinica.',
];
---

<Layout title={title} description={description}>
	<main>
		<section class="px-8 sm:px-20 mt-4 md:mt-10">
			<div class="mx-auto max-w-6xl px-6 pb-14 pt-2 md:pb-20">
				<div class="text-center">
					<a
						href="#modulos"
						class="relative inline-flex rounded-full p-px
							bg-[linear-gradient(90deg,#44cac0,#7ef0e6,#44cac0)]
							bg-size[200%_200%]
							animate-[borderMove_4s_linear_infinite]
							shadow-[0_0_20px_rgba(68,202,192,0.25)]
							transition-all duration-300
							hover:scale-[1.04]
							hover:shadow-[0_0_30px_rgba(68,202,192,0.4)]
							focus:outline-none focus:ring-2 focus:ring-[#44cac0]/40"
					>
						<span
							class="flex items-center gap-2 rounded-full bg-white px-4 py-1 text-xs shadow-sm"
						>
							<span
								class="rounded-full bg-[#ff1fa9]/10 px-2 py-0.5 font-semibold tracking-wide text-[#ff1fa9]"
							>
								MARKETING
							</span>
							<span class="font-medium text-wofy-black">
								Campanas dirigidas por WhatsApp
							</span>
						</span>
					</a>

					<h1
						class="mx-auto mt-5 max-w-4xl text-balance text-4xl font-semibold tracking-tight text-black md:text-6xl"
					>
						El <span class="text-puerto-rico-600">marketing veterinario</span>
						que usa WhatsApp para hablarle a la audiencia correcta.
					</h1>

					<p
						class="mx-auto mt-5 max-w-3xl text-pretty text-md leading-relaxed text-wofy-black md:text-lg"
					>
						Wofy ayuda a hacer marketing dirigido por WhatsApp para
						veterinarias con segmentacion, mensajes personalizados y campanas
						pensadas para retencion, reactivacion y fechas clave. Si hoy tu
						clinica envia el mismo mensaje a todos, esta pagina esta hecha para
						ese problema.
					</p>

					<div class="mt-8 flex items-center justify-center gap-3">
						<a
							href="https://wa.link/y8hfqg"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-2xl bg-puerto-rico-500 px-5 py-3 text-sm font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700 sm:px-10 sm:text-lg"
						>
							Quiero ver el marketing
						</a>
						<a
							href="#modulos"
							class="inline-block rounded-2xl border border-puerto-rico-500 bg-wofy-white px-3 py-3 text-sm font-bold text-puerto-rico-500 transition duration-300 ease-in-out hover:bg-puerto-rico-500 hover:text-wofy-white sm:px-8 sm:text-lg"
						>
							Ver como funciona
						</a>
					</div>

					<p class="mt-5 text-xs text-slate-900/70 md:text-sm">
						Mas precision • Mejor retencion • Menos mensajes genericos
					</p>
				</div>

				<div class="relative mx-auto mt-12 max-w-5xl rounded-4xl border border-slate-200/70 bg-white p-4 shadow-xl md:p-6">
					<Image
						src={marketingFeature}
						alt="Marketing dirigido por WhatsApp en Wofy con segmentacion de audiencias para clinicas veterinarias"
						class="h-auto w-full"
						loading="eager"
						fetchpriority="high"
					/>
				</div>

				<div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
					{
						quickWins.map((item) => (
							<article class="rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm">
								<h2 class="text-xl font-semibold text-black">{item.title}</h2>
								<p class="mt-3 text-sm leading-7 text-wofy-black md:text-base">
									{item.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section id="modulos" class="bg-puerto-rico-50/80">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<div class="text-center">
					<div class="relative inline-flex rounded-full p-px">
						<span
							class="flex items-center gap-2 rounded-full bg-puerto-rico-600 px-5 py-2 text-xs"
						>
							<span class="text-sm font-medium text-wofy-white">
								Lo que hace la diferencia
							</span>
						</span>
					</div>
					<h2 class="mx-auto mt-8 max-w-4xl">
						<span class="text-3xl font-semibold md:text-5xl">
							WhatsApp funciona mejor cuando el marketing tiene direccion
						</span>
					</h2>
					<p class="mx-auto mt-8 max-w-2xl text-lg text-wofy-black">
						No se trata solo de mandar mensajes. Se trata de segmentar, elegir
						el momento correcto y construir campanas que si tengan sentido para
						la mascota y su tutor.
					</p>
				</div>

				<div>
					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-5 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-xl">
								<h2
									class="mb-6 text-3xl font-medium md:text-5xl md:font-semibold"
								>
									Segmenta y dirige campanas por WhatsApp segun tu audiencia
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Elige mejor a quien hablarle y por que. Asi puedes hacer
									marketing veterinario mas preciso con mensajes dirigidos por
									tipo de mascota, edad, raza o cualquier criterio que haga sentido
									para la clinica.
								</p>
							</div>
							<div>
								<Image
									class="w-sm md:w-xl max-w-2xl"
									src={marketingFeature}
									alt="Segmentacion de audiencias para marketing veterinario por WhatsApp en Wofy"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-5 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row-reverse md:px-16"
						>
							<div class="max-w-xl">
								<h2
									class="mb-6 text-3xl font-medium md:text-5xl md:font-semibold"
								>
									Activa retencion con cumpleanos, fechas especiales y reactivacion
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									No todo el valor esta en la siguiente cita. Tambien esta en
									recordar cumpleanos, recuperar clientes que se enfriaron y
									mantener la relacion con detalles que hacen que tu clinica siga
									presente.
								</p>
							</div>
							<div>
								<Image
									class="w-xs md:w-lg max-w-2xl"
									src={birthdayImage}
									alt="Modulo de retencion con cumpleanos del mes para marketing veterinario en Wofy"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-5 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-xl">
								<h2
									class="mb-6 text-3xl font-medium md:text-5xl md:font-semibold"
								>
									Convierte WhatsApp en un canal comercial mas claro para tu equipo
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Cuando el marketing dirigido vive dentro del flujo de la
									clinica, es mas facil sostener conversaciones, medir respuesta y
									mover acciones comerciales sin perder orden operativo.
								</p>
							</div>
							<div>
								<Image
									class="w-xs md:w-lg max-w-2xl"
									src={chatImage}
									alt="Conversacion de WhatsApp usada como canal de marketing veterinario en Wofy"
								/>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="px-8 sm:px-20 mt-20 lg:mt-32">
			<div class="mx-auto max-w-6xl rounded-4xl border border-slate-200/70 bg-white p-8 shadow-xl md:p-12">
				<h2 class="max-w-3xl text-3xl font-semibold text-black md:text-5xl">
					El marketing dirigido por WhatsApp tambien mejora como crece la clinica
				</h2>
				<p class="mt-6 max-w-3xl text-lg leading-8 text-wofy-black">
					Cuando tus campanas llegan a la audiencia correcta, no dependes solo
					de mensajes genricos ni de promociones para todos. Wofy ayuda a que
					WhatsApp se use con mas criterio comercial y mas cercania con el
					tutor.
				</p>
				<ul class="mt-8 space-y-4">
					{
						operatingPoints.map((point) => (
							<li class="flex gap-3 text-base leading-7 text-wofy-black md:text-lg">
								<span class="mt-2 h-2.5 w-2.5 rounded-full bg-puerto-rico-500"></span>
								<span>{point}</span>
							</li>
						))
					}
				</ul>
				<a
					href="https://wa.link/y8hfqg"
					target="_blank"
					rel="noopener noreferrer"
					class="mt-8 inline-block rounded-2xl bg-puerto-rico-500 px-6 py-4 text-base font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700"
				>
					Hablar con Wofy
				</a>
			</div>
		</section>
	</main>
</Layout>
