---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import marketingFeature from '../assets/marketing-feature.png';
import marketingHero from '../assets/marketing-page-hero.png';
import birthdayImage from '../assets/cumpleaños.png';
import chatImage from '../assets/chat.png';
import FeatureCTA from '../components/FeatureCTA.astro';

const title =
	'Marketing veterinario por WhatsApp | Segmentación, retención y campañas dirigidas | Wofy';
const description =
	'Wofy ayuda a hacer marketing veterinario dirigido por WhatsApp con segmentación de audiencias, mensajes personalizados, campañas de retención, cumpleaños y reactivación de clientes.';

const quickWins = [
	{
		title: 'Llega al cliente correcto',
		description:
			'Envía mensajes según la mascota y su contexto. Empieza a generar respuestas reales con mensajes personalizados.'
	},
	{
		title: 'Más citas desde WhatsApp',
		description:
			'Convierte mensajes en citas sin esfuerzo. Tus clientes reciben lo que necesitan y agendan más fácil.'
	},
	{
		title: 'Clientes que regresan',
		description:
			'Reactiva clientes inactivos y mantente presente con mensajes oportunos que los traen de vuelta.'
	},
	{
		title: 'Mensajes en el momento perfecto',
		description:
			'Vacunas, cumpleaños o controles. Contacta justo cuando importa y fortalece la relación con cada cliente.'
	}
];

---

<Layout title={title} description={description}>
	<main>
		<section class="px-8 sm:px-20 mt-4 md:mt-10">
			<div class="mx-auto max-w-6xl px-6 pb-14 pt-2 md:pb-20">
				<div class="text-center">
					<a
						href="#modulos"
						class="relative inline-flex rounded-full p-px
							bg-[linear-gradient(90deg,#44cac0,#7ef0e6,#44cac0)]
							bg-size[200%_200%]
							animate-[borderMove_4s_linear_infinite]
							shadow-[0_0_20px_rgba(68,202,192,0.25)]
							transition-all duration-300
							hover:scale-[1.04]
							hover:shadow-[0_0_30px_rgba(68,202,192,0.4)]
							focus:outline-none focus:ring-2 focus:ring-[#44cac0]/40"
					>
						<span
							class="flex items-center gap-2 rounded-full bg-white px-4 py-1 text-xs shadow-sm"
						>
							<span
								class="rounded-full bg-[#ff1fa9]/10 px-2 py-0.5 font-semibold tracking-wide text-[#ff1fa9]"
							>
								MARKETING
							</span>
							<span class="font-medium text-wofy-black">
								Marketing automático por WhatsApp
							</span>
						</span>
					</a>

					<h1
						class="mx-auto mt-5 max-w-4xl text-balance text-4xl font-semibold tracking-tight text-black md:text-6xl"
					>
						Más citas. Más clientes que regresan.
						<span class="text-puerto-rico-600"
							>Automáticamente.</span
						>
					</h1>

					<p
						class="mx-auto mt-5 max-w-3xl text-pretty text-md leading-relaxed text-wofy-black md:text-lg"
					>
						Envía mensajes por WhatsApp en el momento perfecto para
						que tus clientes vuelvan, agenden y no olviden sus
						citas.
					</p>

					<div class="mt-8 flex items-center justify-center gap-3">
						<a
							href="https://wa.link/y8hfqg"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-2xl bg-puerto-rico-500 px-5 py-3 text-sm font-bold text-white transition duration-300 ease-in-out hover:bg-puerto-rico-700 sm:px-10 sm:text-lg"
						>
							Quiero más citas
						</a>
						<a
							href="#modulos"
							class="inline-block rounded-2xl border border-puerto-rico-500 bg-wofy-white px-3 py-3 text-sm font-bold text-puerto-rico-500 transition duration-300 ease-in-out hover:bg-puerto-rico-500 hover:text-wofy-white sm:px-8 sm:text-lg"
						>
							Ver cómo funciona
						</a>
					</div>

					<p class="mt-5 text-xs text-slate-900/70 md:text-sm">
						Más citas • Mejor retención • Menos huecos en la agenda
					</p>
				</div>

				<div
					class="relative mx-auto mt-12 max-w-5xl rounded-4xl border border-slate-200/70 bg-white p-4 shadow-xl md:p-6"
				>
					<Image
						src={marketingHero}
						alt="Marketing dirigido por WhatsApp en Wofy con segmentación de audiencias para clínicas veterinarias"
						class="h-auto w-full"
						loading="eager"
						fetchpriority="high"
					/>
				</div>

				<div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
					{
						quickWins.map((item) => (
							<article class="rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm">
								<h2 class="text-xl font-semibold text-black">
									{item.title}
								</h2>
								<p class="mt-3 text-sm leading-7 text-wofy-black md:text-base">
									{item.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section id="modulos" class="bg-puerto-rico-50/80">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<div class="text-center">
					<div class="relative inline-flex rounded-full p-px">
						<span
							class="flex items-center gap-2 rounded-full bg-puerto-rico-600 px-5 py-2 text-xs"
						>
							<span class="text-sm font-medium text-wofy-white">
								Lo que hace la diferencia
							</span>
						</span>
					</div>
					<h2 class="mx-auto mt-8 max-w-4xl">
						<span class="text-3xl font-semibold md:text-5xl">
							WhatsApp funciona mejor cuando te genera citas, no
							solo mensajes
						</span>
					</h2>
					<p class="mx-auto mt-8 max-w-2xl text-lg text-wofy-black">
						No se trata de enviar mensajes masivos. Se trata de
						hablarle al cliente correcto en el momento exacto para
						que vuelva a tu veterinaria.
					</p>
				</div>

				<div>
					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-16 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-sm">
								<h2
									class="mb-6 text-2xl font-semibold md:text-4xl"
								>
									Habla con el cliente correcto y deja de
									perder mensajes
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Envía campañas según la mascota, su
									historial o el tipo de cliente. Deja de
									tratar a todos los tutores igual y empieza a
									hablarle a cada uno como corresponde. Cuando
									el mensaje tiene contexto, la diferencia se
									nota. Y las respuestas llegan.
								</p>
							</div>
							<div>
								<Image
									class="w-sm md:w-xl max-w-2xl"
									src={marketingFeature}
									alt="Segmentación de audiencias para marketing veterinario por WhatsApp en Wofy"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-16 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row-reverse md:px-16"
						>
							<div class="max-w-sm">
								<h2
									class="mb-6 text-2xl font-semibold md:text-4xl"
								>
									Haz que tus clientes vuelvan sin tener que
									perseguirlos
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Cumpleaños, vacunas o seguimientos.
									Aprovecha los momentos clave para contactar
									a cada cliente con mensajes que sí tienen
									sentido. Así tu clínica se mantiene presente
									sin ser invasiva, y es más probable que el
									cliente vuelva cuando lo necesita.
								</p>
							</div>
							<div>
								<Image
									class="w-xs md:w-lg max-w-2xl"
									src={birthdayImage}
									alt="Módulo de retención con cumpleaños del mes para marketing veterinario en Wofy"
								/>
							</div>
						</div>
					</article>

					<article>
						<div
							class="mt-12 flex flex-col items-center justify-center gap-16 rounded-2xl border border-slate-200/70 bg-puerto-rico-100/30 px-6 py-10 md:flex-row md:px-16"
						>
							<div class="max-w-sm">
								<h2
									class="mb-6 text-2xl font-semibold md:text-4xl"
								>
									Convierte conversaciones en citas reales
								</h2>
								<p class="text-md text-wofy-black md:text-lg">
									Tu equipo no solo responde mensajes. Ahora
									puede mover clientes, cerrar citas y generar
									ingresos desde WhatsApp.
								</p>
							</div>
							<div>
								<Image
									class="w-xs md:w-lg max-w-2xl"
									src={chatImage}
									alt="Conversación de WhatsApp usada como canal de marketing veterinario en Wofy"
								/>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>
		<FeatureCTA
			header="Transforma la forma en que llegas a tus clientes. Crece más."
		/>
	</main>
</Layout>
