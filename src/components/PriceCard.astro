---
const {
	class: className,
	planName,
	planPrice,
	planDescription,
	features,
	featured = false,
	badgeText = 'Recomendado'
} = Astro.props;
---

<article
	class={`relative w-full max-w-sm rounded-2xl border bg-white p-8 flex flex-col items-center transition-transform hover:-translate-y-2 hover:shadow-xl ${
		featured
			? 'border-[#ff1fa9] shadow-[0_18px_40px_rgba(255,31,169,0.14)] ring-1 ring-[#ff1fa9]/15'
			: 'border-slate-200'
	} ${className ?? ''}`}
>
	{
		featured && (
			<div class="absolute -top-4 left-1/2 -translate-x-1/2">
				<span class="rounded-full bg-[#ff1fa9] px-4 py-1.5 text-xs font-semibold tracking-wide text-white shadow-lg shadow-[#ff1fa9]/25">
					{badgeText}
				</span>
			</div>
		)
	}
	<div class="flex flex-col items-start mb-8 gap-10 w-full">
		<div class="text-left flex flex-col gap-4">
			<h2 class={`text-2xl font-bold mb-2 ${featured ? 'text-[#ff1fa9]' : 'text-wofy-black'}`}>{planName}</h2>
			<div class="flex gap-2 items-center text-black">
				<span class="text-5xl font-bold">${planPrice}</span><span class="text-sm"
					>por mes</span
				>
			</div>
			<p class="text-gray-600 text-start">
				{planDescription}
			</p>
		</div>
		<a
			href="https://wa.link/y8hfqg"
			target="_blank"
			class="w-full block text-center bg-puerto-rico-600 text-white text-sm font-semibold py-3 px-10 rounded-2xl sm:text-sm hover:bg-puerto-rico-700 transition duration-300 ease-in-out"
			aria-label="Ver cómo funciona Wofy"
		>
			Empieza ahora
		</a>
	</div>
	<div class="flex flex-col items-start w-full">
		<p class="text-gray-700 mb-6">Características incluidas:</p>
		<ul class="mb-6 space-y-2 w-full">
      {features.map((feature: string) => (
        <li class="flex items-start gap-2">
          <span class="text-[#1fcfc1]">✓</span><span>{feature}</span>
        </li>
      ))}
		</ul>
	</div>
</article>
