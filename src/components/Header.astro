---
import { Image } from 'astro:assets';
import logoWofy from '../assets/logo-wofy.png';
---

<header
	class="sticky top-0 z-50 overflow-visible bg-white shadow-sm h-20 px-10 lg:px-20 xl:px-32"
>
	<div
		class="hidden md:grid grid-cols-[auto_1fr_auto] items-center justify-center h-full"
	>
		<!-- Logo -->
		<div class="flex items-center gap-12 min-w-max">
			<a href="/">
				<Image
					src={logoWofy}
					alt="wofy"
					class="h-auto w-32"
					loading="eager"
				/>
			</a>
		</div>
		<!-- Navegación -->
		<div class="flex justify-center items-center gap-10 min-w-max">
			<nav
				class="hidden md:flex items-center gap-x-10 text-wofy-black font-medium active:text-puerto-rico-800"
			>
				<div class="relative group">
					<button
						type="button"
						class="flex items-center gap-2 hover:text-puerto-rico-700"
					>
						Producto
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-4 w-4 transition-transform group-hover:rotate-180"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M19 9l-7 7-7-7"></path>
						</svg>
					</button>

					<div
						class="absolute left-1/2 -translate-x-1/2 top-full mt-4 w-112.5 rounded-2xl border border-slate-200 bg-white shadow-xl p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200"
					>
						<a
							href="/agenda"
							class="block rounded-xl px-4 py-4 transition hover:bg-slate-50"
						>
							<p class="text-base font-semibold text-wofy-black">
								Agenda inteligente
							</p>
							<p class="mt-1 text-sm leading-5 text-slate-500">
								Organiza citas, recordatorios y el flujo diario
								de tu veterinaria.
							</p>
						</a>

						<a
							href="/historial-clinico"
							class="block rounded-xl px-4 py-4 transition hover:bg-slate-50"
						>
							<p class="text-base font-semibold text-wofy-black">
								Historia clínica
							</p>
							<p class="mt-1 text-sm leading-5 text-slate-500">
								Consulta la información médica de cada mascota
								de forma rápida y ordenada.
							</p>
						</a>

						<a
							href="/marketing"
							class="block rounded-xl px-4 py-4 transition hover:bg-slate-50"
						>
							<p class="text-base font-semibold text-wofy-black">
								Marketing por WhatsApp
							</p>
							<p class="mt-1 text-sm leading-5 text-slate-500">
								Crea campañas y seguimientos para volver a
								atraer clientes.
							</p>
						</a>

						<a
							href="/#servicios"
							class="block rounded-xl px-4 py-4 transition hover:bg-slate-50"
						>
							<p class="text-base font-semibold text-wofy-black">
								Reportes y control
							</p>
							<p class="mt-1 text-sm leading-5 text-slate-500">
								Visualiza métricas clave para tomar mejores
								decisiones.
							</p>
						</a>
					</div>
				</div>

				<a class="hover:text-puerto-rico-700" href="/pricing">Planes</a>
				<a class="hover:text-puerto-rico-700" href="/nosotros">Nosotros</a>
			</nav>
		</div>
		<!-- Botón de acción -->
		<div class="flex items-center gap-2">
			<a
				href="https://portal.wofy.app"
				target="_blank"
				class="hidden md:flex text-puerto-rico-600 font-medium sm:px-6 sm:py-4 rounded-md hover:text-puerto-rico-900 active:text-puerto-rico-700 transition duration-300 ease-in-out"
			>
				Iniciar sesión
			</a>
			<a
				href="https://wa.link/y8hfqg"
				target="_blank"
				class="hidden md:flex bg-puerto-rico-500 text-wofy-white font-medium sm:px-6 sm:py-4 rounded-md hover:bg-puerto-rico-600 active:bg-puerto-rico-700 transition duration-300 ease-in-out"
			>
				Empieza gratis
			</a>
		</div>
	</div>
	<!-- Menú móvil -->
	<div class="flex md:hidden justify-between items-center h-full">
		<a href="/">
			<Image
				src={logoWofy}
				alt="wofy"
				class="h-auto w-32"
				loading="eager"
			/>
		</a>

		<input type="checkbox" id="mobile-menu-toggle" class="hidden" />
		<label
			for="mobile-menu-toggle"
			class="mobile-menu-toggle-button rounded text-gray-600 transition hover:text-gray-600/75 cursor-pointer"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="h-5 w-5"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="2"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</label>

		<nav
			id="mobile-menu"
			class="mobile-menu md:hidden fixed top-20 left-0 right-0 bottom-0 bg-white flex flex-col px-8 py-6"
		>
			<div class="flex flex-col gap-2">
				<div class="w-full">
					<button
						type="button"
						id="mobile-features-button"
						class="w-full flex justify-between items-center py-4 border-b border-slate-100 hover:text-puerto-rico-700"
					>
						<span>Producto</span>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-4 w-4 transition-transform"
							id="mobile-features-icon"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M19 9l-7 7-7-7"></path>
						</svg>
					</button>

					<div
						id="mobile-features-dropdown"
						class="hidden mt-3 flex-col rounded-2xl bg-slate-50 overflow-hidden"
					>
						<a
							href="/agenda"
							class="block w-full px-4 py-4 border-b border-slate-200"
						>
							Agenda inteligente
						</a>
						<a
							href="/historial-clinico"
							class="block w-full px-4 py-4 border-b border-slate-200"
						>
							Historia clínica
						</a>
						<a
							href="/marketing"
							class="block w-full px-4 py-4 border-b border-slate-200"
						>
							Marketing WhatsApp
						</a>
						<a href="/#servicios" class="block w-full px-4 py-4">
							Reportes
						</a>
					</div>
				</div>

				<a class="py-4 border-b border-slate-100" href="/pricing">
					Planes
				</a>

				<a class="py-4 border-b border-slate-100" href="/nosotros">
					Nosotros
				</a>
			</div>

			<div class="mt-auto flex flex-col gap-4 pt-6">
				<a
					href="https://portal.wofy.app"
					class="flex justify-center px-6 py-4 bg-slate-200 text-wofy-black font-bold rounded-xl"
				>
					Iniciar sesión
				</a>

				<a
					href="https://wa.link/y8hfqg"
					class="flex justify-center px-6 py-4 bg-puerto-rico-500 text-wofy-white font-bold rounded-xl hover:bg-puerto-rico-600 transition"
				>
					Empieza gratis
				</a>
			</div>
		</nav>
	</div>

	<style>
		.mobile-menu {
			display: none;
		}

		#mobile-menu-toggle:checked + label + nav {
			display: flex;
		}
	</style>

	<script>
		const mobileBtn = document.getElementById('mobile-features-button');
		const mobileDropdown = document.getElementById(
			'mobile-features-dropdown'
		);
		const mobileIcon = document.getElementById('mobile-features-icon');

		if (mobileBtn && mobileDropdown && mobileIcon) {
			mobileBtn.addEventListener('click', () => {
				mobileDropdown.classList.toggle('hidden');

				// animar flechita
				mobileIcon.classList.toggle('rotate-180');
			});
		}
	</script>
</header>
